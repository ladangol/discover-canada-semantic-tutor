# /etc/discover-study.env  (create it ON THE SERVER; owner root, mode 600; do not commit the real file)
# Placeholders only: put your own values on the server.
VENICE_API_KEY=your_key_here
VENICE_MODEL=z-ai-glm-5-3-flash

# Spend control (see deploy/README.md section 2). Look up YOUR model's prices on Venice and fill them in.
STUDY_DAILY_USD_BUDGET=1.00
# z-ai-glm-5-3-flash on Venice (Oct 2026): $0.15 in / $0.50 out per 1M tokens. Check Venice pricing if you change model.
VENICE_PRICE_IN_PER_M=0.15
VENICE_PRICE_OUT_PER_M=0.50
# Safety net far above what $1 buys, so the dollar cap is the one that normally binds.
STUDY_DAILY_TOKEN_BUDGET=5000000
STUDY_MAX_ACTIONS=40
STUDY_MAX_ACTIONS_PER_VISITOR_DAY=60
STUDY_LIVE_TIMELINES=0
STUDY_TZ=America/Toronto
