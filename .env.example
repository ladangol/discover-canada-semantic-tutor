VENICE_API_KEY=your_key_here
VENICE_MODEL=z-ai-glm-5-3-flash

# --- optional, for a public deployment (see deploy/README.md) -------------------------------------
# STUDY_DAILY_USD_BUDGET=1.00          # needs the two prices below to be enforced
# VENICE_PRICE_IN_PER_M=               # $ per 1M prompt tokens for your model (see Venice pricing)
# VENICE_PRICE_OUT_PER_M=              # $ per 1M completion tokens
# STUDY_DAILY_TOKEN_BUDGET=500000      # safety net that works without prices
# STUDY_MAX_ACTIONS_PER_VISITOR_DAY=60
# STUDY_LIVE_TIMELINES=0               # 0 = only serve pre-built timelines (cheapest)
# STUDY_TZ=America/Toronto

# --- Voice tutor (optional; Milestone 1). Placeholders only, see README "Voice tutor" ---
# STUDY_VOICE=1
# ASR_MODEL=small
# ASR_DEVICE=cpu
# ASR_COMPUTE_TYPE=int8
# ASR_LANGUAGE=en
# TTS_VOICE_PATH=/absolute/path/to/voice.onnx
# VOICE_MAX_SECONDS=30
# VOICE_MAX_CONCURRENCY=1
# STUDY_VOICE_DIAGNOSTICS=1
# TTS_LENGTH_SCALE=1.1       # >1 = slower
# TTS_NOISE_SCALE=0.8        # voice variability
# TTS_NOISE_W=0.95           # rhythm variability
# TTS_SENTENCE_PAUSE_MS=280  # silence between sentences
# TTS_ENGINE=kokoro            # default; "piper" uses TTS_VOICE_PATH instead
# KOKORO_VOICE=af_heart        # af_*/am_* American, bf_*/bm_* British (54 voices)
# KOKORO_SPEED=1.0
# TTS_ENGINE=kokoro-onnx     # same Kokoro via ONNX Runtime: int8 model ~92 MB, no torch (see docs/VOICE_ARCHITECTURE.md)
# KOKORO_ONNX_MODEL=models/kokoro-onnx/kokoro-v1.0.int8.onnx
# KOKORO_ONNX_VOICES=models/kokoro-onnx/voices-v1.0.bin
# QUERY_CLEANUP=0               # turn off the application-layer retrieval-query cleanup (default on)
# STUDY_ENUMERATION=1          # show the "scan the whole guide" panel (several AI calls per use)
