VENICE_API_KEY=your_key_here
VENICE_MODEL=z-ai-glm-5-3-flash

# --- optional, for a public deployment (see deploy/README.md) -------------------------------------
# STUDY_DAILY_USD_BUDGET=1.00          # needs the two prices below to be enforced
# VENICE_PRICE_IN_PER_M=               # $ per 1M prompt tokens for your model (see Venice pricing)
# VENICE_PRICE_OUT_PER_M=              # $ per 1M completion tokens
# STUDY_DAILY_TOKEN_BUDGET=500000      # safety net that works without prices
# STUDY_MAX_ACTIONS_PER_VISITOR_DAY=60
# STUDY_LIVE_TIMELINES=0               # 0 = only serve pre-built timelines (cheapest)
# STUDY_TZ=America/Toronto
